{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llama-coder": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local llama.cpp (Orchestrator - Coder)",
      "options": {
        "baseURL": "http://192.168.0.100:8082/qwen3-coder-30b/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "qwen3-coder-30b-q4": {
          "name": "Qwen3 Coder 30B Q4",
          "tools": true,
          "context_length": 65536,
          "max_tokens": 8192
        }
      }
    },
    "llama-reasoning": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local llama.cpp (Orchestrator - Reasoning)",
      "options": {
        "baseURL": "http://192.168.0.100:8082/qwen38-27b/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "qwen38-27b-ud-q3": {
          "name": "Qwen 3.8 27B UD-Q3",
          "tools": true,
          "context_length": 58000,
          "max_tokens": 8192
        }
      }
    }
  },
  "model": "llama-reasoning/qwen38-27b-ud-q3",
  "compaction": { "auto": true, "prune": true, "tail_turns": 4, "reserved": 10000 },
  "tool_output": { "max_lines": 150, "max_bytes": 6144 },
  "formatter": true,
  "lsp": true,
  "mcp": {
    "searxng": {
      "type": "local",
      "command": ["npx", "-y", "mcp-searxng"],
      "enabled": true,
      "environment": {
        "SEARXNG_URL": "http://192.168.0.100:8888"
      }
    }
  }
}
